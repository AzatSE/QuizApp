# Скопируйте в .env (он в .gitignore). НИКОГДА не коммитьте .env
# Сгенерировать ключ: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# Через запятую. Для теста с телефона в локальной сети добавьте IP компьютера
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# Публичный адрес для QR-кода (если за прокси). Без слэша в конце
PUBLIC_BASE_URL=https://example.com
# 1 если стоите за nginx/Caddy, который выставляет X-Forwarded-Proto/For
DJANGO_TRUST_PROXY=1
DJANGO_SSL_REDIRECT=1
# 0 — закрыть регистрацию ведущих
ALLOW_SIGNUP=1

# --- Railway ---
# Задавать вручную нужно только DJANGO_SECRET_KEY и DATABASE_URL (=${{Postgres.DATABASE_URL}}).
# RAILWAY_PUBLIC_DOMAIN, PORT и RAILWAY_ENVIRONMENT Railway выставляет сам.
